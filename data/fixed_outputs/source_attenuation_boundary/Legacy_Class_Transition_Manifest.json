{
  "script_version": "v1.2",
  "analysis_label": "Literature-scaled PFAS class-transition experiment",
  "claim_scope": "Observed 2015-2022 Chinese group-level industrial-use mass ratios are transferred to the 2018 riverine source boundary under a stable use-to-river-release proportionality assumption. Outputs are counterfactual perturbations, not absolute emission estimates or calendar-year forecasts. Application-weighted water releases exclude textile and pharmaceutical-intermediate use because their reported release factors are not allocated to water; those estimates are diagnostic only.",
  "calculation_chain": [
    "Read compound-by-application annual use masses from Cai et al. Table S8",
    "Sum the six applications to obtain each compound's annual use mass",
    "Sum mapped compounds to obtain each GDR group's annual use mass",
    "Divide comparison-year group mass by reference-year group mass",
    "Apply the resulting dimensionless ratio to every inventory compound in that GDR group"
  ],
  "group_aggregation_rule": "GDR group multipliers are ratios of summed group masses. Compound-specific growth rates are not averaged.",
  "use_to_source_equation": "river_source_group_scenario = river_source_group_baseline * (group_use_mass_comparison_year / group_use_mass_reference_year)",
  "water_release_diagnostic_equation": "attributed_water_release = sum(application_use_mass * explicit_water_release_fraction_of_use)",
